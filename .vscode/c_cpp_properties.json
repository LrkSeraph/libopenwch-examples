{
    "version": 4,
    "configurations": [
        {
            "name": "libopenwch",
            "includePath": [
                "${workspaceFolder}/**",
                "${workspaceFolder}/libopenwch/include",
                "${workspaceFolder}/../libopenwch/include",
                "${workspaceFolder}/../../libopenwch/include",
                "${workspaceFolder}/../include",
                "${workspaceFolder}/../../include"
            ],
            "defines": [
                "CH32V0"
            ],
            "cStandard": "c99",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-riscv32",
            "compilerPath": "/usr/bin/riscv64-unknown-elf-gcc",
            "compilerArgs": [
                "-march=rv32ec_zmmul_zicsr_zifencei",
                "-mabi=ilp32e"
            ]
        }
    ]
}
