{
    "files.associations": {
        "*.h": "c",
        "*.ld": "ld",
        "*.S": "riscv"
    },
    "C_Cpp.default.cStandard": "c99",
    "C_Cpp.default.intelliSenseMode": "linux-gcc-riscv32",
    "editor.tabSize": 8,
    "editor.insertSpaces": false,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "search.exclude": {
        "**/bin": true,
        "**/*.elf": true,
        "**/*.bin": true
    }
}
